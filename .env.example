# ENTSO-E Transparency Platform API token. Acquisition tooling only.
ENTSOE_API_KEY=

# Shared FMV data foundation consumed by LT, CT, dashboards and internal tools.
FMV_DATA_ROOT=D:\FMV\PFC\data
# Transitional aliases only; do not set them in a new deployment.
# PFC_LT_DATA_ROOT=D:\FMV\PFC\data
# PFC_SHARED_DATA_ROOT=D:\FMV\PFC\data
# PFC_ENTSOE_DATA_ROOT=D:\FMV\PFC\data\entsoe

# REGISTRAR role only. The private key signs each exact content-addressed
# release request; audit and promotion receive only the trusted public key.
# PFC_RELEASE_REQUEST_SIGNING_PRIVATE_KEY_PATH=D:\FMV\PFC\secrets\release-request-private.pem
PFC_RELEASE_REQUEST_TRUSTED_PUBLIC_KEY_PATH=D:\FMV\PFC\trust\release-request-public.pem
PFC_RELEASE_REQUEST_TRUSTED_PUBLIC_KEY_DIR=D:\FMV\PFC\trust\release-request-public-keyring
# Stable UUID for the logical workflow domain, generated once per environment.
PFC_RELEASE_WORKFLOW_DOMAIN_ID=

# AUDITOR role only. Never expose EVENT signing material to this identity.
# PFC_PROMOTION_SIGNING_PRIVATE_KEY_PATH=D:\FMV\PFC\secrets\promotion-signing-private.pem
PFC_PROMOTION_TRUSTED_PUBLIC_KEY_PATH=D:\FMV\PFC\trust\promotion-signing-public.pem
# Replay-only receipt keys from prior epochs. They cannot authorize new events
# and must not overlap event or rollback keyrings.
PFC_PROMOTION_TRUSTED_PUBLIC_KEY_DIR=D:\FMV\PFC\trust\receipt-public-keyring

# PROMOTER role only. Never expose RECEIPT signing material to this identity.
# PFC_PROMOTION_EVENT_SIGNING_PRIVATE_KEY_PATH=D:\FMV\PFC\secrets\promotion-event-private.pem
PFC_PROMOTION_EVENT_TRUSTED_PUBLIC_KEY_PATH=D:\FMV\PFC\trust\promotion-event-public.pem
# Replay-only event keys from prior epochs. This keyring must not overlap the
# receipt or rollback keyrings.
PFC_PROMOTION_EVENT_TRUSTED_PUBLIC_KEY_DIR=D:\FMV\PFC\trust\event-public-keyring

# Stable UUID for one logical release domain. Generate once and never reuse
# across environments or physical release roots.
PFC_PROMOTION_RELEASE_DOMAIN_ID=
PFC_PROMOTION_JOURNAL_ROOT=D:\FMV\PFC\journal\promotion
PFC_PROMOTION_LOCK_WAIT_SECONDS=0

# ROLLBACK AUTHORIZER public trust only. Its private key remains absent from
# promoter and rollback transition services.
PFC_ROLLBACK_AUTHORIZATION_TRUSTED_PUBLIC_KEY_PATH=D:\FMV\PFC\trust\rollback-authorization-public.pem
PFC_ROLLBACK_AUTHORIZATION_TRUSTED_PUBLIC_KEY_DIR=D:\FMV\PFC\trust\rollback-public-keyring

# Data, trusted-time and policy trust anchors.
PFC_DATA_ACQUISITION_TRUSTED_PUBLIC_KEY_PATH=D:\FMV\PFC\trust\acquisition-signing-public.pem
PFC_DATA_TIMESTAMP_TRUSTED_PUBLIC_KEY_PATH=D:\FMV\PFC\trust\data-timestamp-public.pem
PFC_DATA_TIMESTAMP_JOURNAL_ID=
PFC_QUOTE_CONFLICT_POLICY_TRUSTED_PUBLIC_KEY_PATH=D:\FMV\PFC\trust\quote-conflict-policy-public.pem
PFC_MODEL_GOVERNANCE_TRUSTED_PUBLIC_KEY_PATH=D:\FMV\PFC\trust\model-governance-public.pem

# Immutable governed decisions and receipts.
PFC_HISTORICAL_THRESHOLDS_PATH=D:\FMV\PFC\governed\historical_thresholds.csv
PFC_HISTORICAL_THRESHOLDS_RECEIPT_PATH=D:\FMV\PFC\governed\historical_thresholds.receipt.json
PFC_SELECTED_LAMBDA_DECISION_PATH=D:\FMV\PFC\governed\selected_lambda_decision.json
PFC_SELECTED_LAMBDA_DECISION_RECEIPT_PATH=D:\FMV\PFC\governed\selected_lambda_decision.receipt.json

# Exact EEX workbook and its signed source acquisition contract.
PFC_EEX_REPORT_PATH=D:\FMV\PFC\inputs\Price_Report_EEX.xlsx
PFC_EEX_ACQUISITION_CONTRACT_PATH=D:\FMV\PFC\governed\eex_forward_source.acquisition.json

# Databricks acquisition is source-side tooling and is deliberately absent from
# the sealed LT runtime environment and wheel.

# Optional operations notification endpoint.
# TEAMS_WEBHOOK_URL=https://notifications.example.invalid/pfc-lt
