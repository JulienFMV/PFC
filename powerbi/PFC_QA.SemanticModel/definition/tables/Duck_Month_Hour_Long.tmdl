				    Typed = Table.TransformColumnTypes(Promoted, {{"year", Int64.Type}, {"month", Int64.Type}, {"month_code", type text}, {"hour", Int64.Type}, {"hour_code", type text}, {"series", type text}, {"price_eur_mwh", type number}, {"series_label", type text}})
